# Server Configuration
SERVER_PORT=8080

# PostgreSQL Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=echotrace
DB_USER=echotrace_user
DB_PASSWORD=echotrace_secure_password
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/echotrace

# Audio Processing Configuration
ECHOTRACE_SAMPLE_RATE=11025
ECHOTRACE_FFT_SIZE=1024
ECHOTRACE_HOP_SIZE=512
ECHOTRACE_MAX_UPLOAD_BYTES=26214400
ECHOTRACE_FFMPEG_PATH=ffmpeg

# CORS & Frontend
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
VITE_API_BASE_URL=http://localhost:8080/api/v1
VITE_WS_URL=ws://localhost:8080/api/v1/ws/audio-stream
