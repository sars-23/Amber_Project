# -------------------------------------------------------------
# EchoTrace Environment Configuration Template
# Copy to .env for local overrides (never commit secrets to Git)
# -------------------------------------------------------------

# Backend Server Configuration
# (Render automatically sets PORT; SERVER_PORT is used as local default)
SERVER_PORT=8080
PORT=8080

# PostgreSQL Configuration
# Local Docker or Direct Postgres:
DB_HOST=localhost
DB_PORT=5432
DB_NAME=echotrace
DB_USER=echotrace_user
DB_PASSWORD=echotrace_secure_password
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/echotrace

# Production PostgreSQL (Neon / Render Postgres / Supabase):
# Note: Neon requires ?sslmode=require
# SPRING_DATASOURCE_URL=jdbc:postgresql://ep-example-12345.us-east-2.aws.neon.tech/echotrace?sslmode=require
# SPRING_DATASOURCE_USERNAME=neondb_owner
# SPRING_DATASOURCE_PASSWORD=your_neon_password

# Audio Processing Configuration
ECHOTRACE_SAMPLE_RATE=11025
ECHOTRACE_FFT_SIZE=1024
ECHOTRACE_HOP_SIZE=512
ECHOTRACE_MAX_UPLOAD_BYTES=26214400
ECHOTRACE_FFMPEG_PATH=ffmpeg

# CORS (Backend)
# Comma-separated list or patterns of allowed origins
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://*.vercel.app

# Frontend Configuration (Vercel / Local Vite)
# Set in Vercel project environment variables:
# VITE_API_BASE_URL=https://echotrace-backend.onrender.com/api/v1
# VITE_WS_URL=wss://echotrace-backend.onrender.com/api/v1/ws/audio-stream
VITE_API_BASE_URL=http://localhost:8080/api/v1
VITE_WS_URL=ws://localhost:8080/api/v1/ws/audio-stream

# JVM Options (Render container memory limit)
JAVA_OPTS=-XX:+UseContainerSupport -XX:MaxRAMPercentage=75.0
